rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.uid == 'CNVGNLTvMdeDh9J2LYkofozpmQ42';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Public civic reports collection
    match /reports/{reportId} {
      allow read: if true;
      allow create: if isValidId(reportId);
      allow update: if isValidId(reportId);
      allow delete: if isValidId(reportId);
    }

    // Volunteer users collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId);
      allow delete: if (isOwner(userId) || isAdmin()) && isValidId(userId);
    }

    // System settings (e.g. leaderboard cycle)
    match /system_settings/{settingId} {
      allow read, write: if true;
    }
  }
}
